async def send_request_to_log(
    req_id: str,
    uid: int,
    full_name: str,
    username: str,
    method: str,
    ton_address: str,
    links: list,
):
    method_label = "🤖 ОТС Бот" if method == "ots" else "🛡️ Живой гарант"
    links_fmt    = "\n".join(f"{i+1}. {l}" for i, l in enumerate(links))
    now          = datetime.now().strftime("%d.%m.%Y %H:%M")
    links_str    = "\n".join(links)

    text = (
        f"🆕 <b>Новая заявка на выплату</b>\n"
        f"🆔 <b>Заявка:</b> <code>{req_id}</code>\n\n"
        f"👤 <b>Пользователь:</b> {full_name}\n"
        f"🔗 <b>Username:</b> {username}\n"
        f"🆔 <b>TG ID:</b> <code>{uid}</code>\n\n"
        f"💳 <b>Метод:</b> {method_label}\n"
        f"💎 <b>TON Адрес:</b>\n<code>{ton_address}</code>\n\n"
        f"🎁 <b>Ссылки ({len(links)} шт.):</b>\n{links_fmt}\n\n"
        f"🕐 <b>Время:</b> {now} (МСК)"
    )

    # Сохраняем в БД до отправки
    db_save_request(req_id, uid, method, ton_address, links_str, msg_id=0)

    # Отправляем в канал
    sent = await bot.send_message(
        chat_id=LOG_CHANNEL_ID,
        text=text,
        parse_mode="HTML",
        disable_web_page_preview=True,
        reply_markup=request_kb(req_id),
    )

    # Обновляем msg_id
    con = sqlite3.connect(DB_PATH)
    con.execute("UPDATE requests SET msg_id=? WHERE req_id=?",
                (sent.message_id, req_id))
    con.commit()
    con.close()

    log.info(f"Заявка {req_id} отправлена в канал, msg_id={sent.message_id}")
    return sent.message_id


