DB_PATH = "sam.db"


def db_init():
    con = sqlite3.connect(DB_PATH)
    cur = con.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS users (
            uid         INTEGER PRIMARY KEY,
            username    TEXT,
            full_name   TEXT,
            profits     INTEGER DEFAULT 0,
            total_ton   REAL    DEFAULT 0,
            wallet      TEXT    DEFAULT '',
            joined_at   TEXT    DEFAULT ''
        )
    """)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS requests (
            req_id      TEXT    PRIMARY KEY,
            uid         INTEGER,
            method      TEXT,
            ton_address TEXT,
            links       TEXT,
            status      TEXT    DEFAULT 'pending',
            ton_amount  REAL    DEFAULT 0,
            created_at  TEXT,
            msg_id      INTEGER DEFAULT 0
        )
    """)
    con.commit()
    con.close()


def db_upsert_user(uid: int, username: str, full_name: str):
    con = sqlite3.connect(DB_PATH)
    con.execute("""
        INSERT INTO users (uid, username, full_name, joined_at)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(uid) DO UPDATE SET
            username  = excluded.username,
            full_name = excluded.full_name
    """, (uid, username or "", full_name, datetime.now().strftime("%d.%m.%Y")))
    con.commit()
    con.close()


def db_get_user(uid: int) -> dict | None:
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    row = con.execute("SELECT * FROM users WHERE uid=?", (uid,)).fetchone()
    con.close()
    return dict(row) if row else None


def db_save_request(req_id, uid, method, ton_address, links_str, msg_id=0):
    con = sqlite3.connect(DB_PATH)
    con.execute("""
        INSERT OR REPLACE INTO requests
            (req_id, uid, method, ton_address, links, status, created_at, msg_id)
        VALUES (?, ?, ?, ?, ?, 'pending', ?, ?)
    """, (req_id, uid, method, ton_address, links_str,
          datetime.now().strftime("%d.%m.%Y %H:%M"), msg_id))
    con.commit()
    con.close()


def db_get_request(req_id: str) -> dict | None:
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    row = con.execute("SELECT * FROM requests WHERE req_id=?", (req_id,)).fetchone()
    con.close()
    return dict(row) if row else None


def db_set_status(req_id: str, status: str, ton_amount: float = 0):
    con = sqlite3.connect(DB_PATH)
    con.execute("""
        UPDATE requests SET status=?, ton_amount=? WHERE req_id=?
    """, (status, ton_amount, req_id))
    if status == "paid" and ton_amount > 0:
        req = db_get_request(req_id)
        if req:
            con.execute("""
                UPDATE users
                SET profits   = profits  + 1,
                    total_ton = total_ton + ?
                WHERE uid = ?
            """, (ton_amount, req["uid"]))
    con.commit()
    con.close()


def db_get_rank(profits: int) -> str:
    ranks = [
        (100, "Мастер"),
        (60,  "Эксперт"),
        (30,  "Специалист"),
        (15,  "Работник"),
        (5,   "Стажёр"),
        (0,   "Новичок"),
    ]
    for min_p, name in ranks:
        if profits >= min_p:
            return name
    return "Новичок"


