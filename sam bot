@dp.callback_query(F.data.startswith("pay:"))
async def cb_pay(call: CallbackQuery):
    if call.from_user.id not in ADMIN_IDS:
        return await call.answer("⛔️ Нет доступа", show_alert=True)

    req_id = call.data.split(":", 1)[1]
    req    = db_get_request(req_id)
    if not req:
        return await call.answer("❌ Заявка не найдена", show_alert=True)
    if req["status"] != "pending":
        return await call.answer(
            f"Заявка уже обработана: {req['status']}", show_alert=True
        )

    await call.message.edit_reply_markup(reply_markup=confirm_pay_kb(req_id))
    await call.answer("Выбери сумму 👇")


