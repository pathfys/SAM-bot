async def _finalize_payout(call: CallbackQuery, req_id: str, ton_amount: float):
    await _do_payout(req_id, ton_amount)

    try:
        # Берём текст безопасно — избегаем html_text на канальных сообщениях
        original = call.message.text or ""
        await call.message.edit_text(
            original + f"\n\n✅ <b>ВЫПЛАЧЕНО: {ton_amount} TON</b>",
            parse_mode="HTML",
            disable_web_page_preview=True,
        )
    except TelegramBadRequest as e:
        log.warning(f"Не удалось отредактировать сообщение: {e}")

    await call.answer(f"✅ Выплата {ton_amount} TON зачтена!", show_alert=True)


async def _do_payout(req_id: str, ton_amount: float):
    req  = db_get_request(req_id)
    if not req:
        log.error(f"_do_payout: заявка {req_id} не найдена")
        return

    db_set_status(req_id, "paid", ton_amount)

    user = db_get_user(req["uid"])
    profits_new = (user["profits"] + 1) if user else 1
    rank = db_get_rank(profits_new)
    method_label = "ОТС Бот" if req["method"] == "ots" else "Живой гарант"

    # Канал выплат
    try:
        await bot.send_message(
            PAY_CHANNEL_ID,
            f"✅ <b>Успешная выплата!</b>\n\n"
            f"<blockquote>"
            f"👤 Воркер: скрыт\n"
            f"🔧 Инструмент: {method_label}\n"
            f"💎 Сумма: {ton_amount} TON\n"
            f"⭐️ Уровень: {rank}"
            f"</blockquote>",
            parse_mode="HTML",
        )
    except Exception as e:
        log.warning(f"Не удалось отправить в PAY_CHANNEL: {e}")

    # Уведомление воркеру
    try:
        await bot.send_message(
            req["uid"],
            f"✅ <b>Заявка {req_id} выплачена!</b>\n\n"
            f"💎 Сумма: <b>{ton_amount} TON</b>\n"
            f"⭐️ Твой ранг: <b>{rank}</b>\n\n"
            f"Открой приложение чтобы увидеть обновлённый статус 👇",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(inline_keyboard=[[
                InlineKeyboardButton(
                    text="🚀 Открыть SAM",
                    web_app=WebAppInfo(url=WEBAPP_URL)
                )
            ]]),
        )
    except Exception as e:
        log.warning(f"Не удалось уведомить воркера {req['uid']}: {e}")


