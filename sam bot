@dp.message(F.text.startswith("pay "))
async def cmd_pay_manual(message: Message):
    if message.from_user.id not in ADMIN_IDS:
        return

    parts = message.text.strip().split()
    if len(parts) != 3:
        return await message.reply("❗ Формат: <code>pay REQ-XXX 7.5</code>", parse_mode="HTML")

    _, req_id, ton_str = parts
    try:
        ton_amount = float(ton_str)
    except ValueError:
        return await message.reply("❗ Некорректная сумма")

    req = db_get_request(req_id)
    if not req:
        return await message.reply("❌ Заявка не найдена")
    if req["status"] != "pending":
        return await message.reply(f"Заявка уже обработана: {req['status']}")

    await _do_payout(req_id, ton_amount)
    await message.reply(f"✅ Выплата {ton_amount} TON по заявке {req_id} зачтена!")


